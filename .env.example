# Template for .env. Copy this to `.env` (git-ignored) and fill in.
#
#   cp .env.example .env
#
# Step 1 geocodes GEOCODE_ADDRESS via PDOK Locatieserver to find the map center.
# Use a precise address PDOK/BAG can resolve to a single building:
#   street + house number, postcode, city.
GEOCODE_ADDRESS="<street + number>, <postcode> <city>"
#
# CENTER_X / CENTER_Y: the resolved center in RD New (EPSG:28992) meters. config.py reads
# these directly (no network needed). Run Step 1 once to discover them, then paste here.
CENTER_X=<rd_easting_in_meters>
CENTER_Y=<rd_northing_in_meters>
