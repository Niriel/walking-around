# Local secrets / PII (home address, API keys) — never commit. Copy .env.example -> .env.
.env

# Python
__pycache__/
*.py[cod]

# uv-managed virtual environment
.venv/

# GIS pipeline artifacts — regenerable from the pipeline, kept out of git history.
# The .gitkeep files preserve the (otherwise empty) directory skeleton.
/data/raw/*
/data/processed/*
!/data/raw/.gitkeep
!/data/processed/.gitkeep
