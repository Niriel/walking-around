# Local secrets / PII (home address, API keys) — never commit. Copy .env.example -> .env.
.env

# Python
__pycache__/
*.py[cod]

# uv-managed virtual environment
.venv/

# Godot-bound pipeline assets (copied from data/processed; regenerable, may reveal the center)
/godot/assets/

# QGIS project files (local visual-inspection scratch; not part of the pipeline)
*.qgz
*.qgs
*.qgz~
*.qgs~

# GIS pipeline artifacts — regenerable from the pipeline, kept out of git history.
# The .gitkeep files preserve the (otherwise empty) directory skeleton.
/data/raw/*
/data/processed/*
!/data/raw/.gitkeep
!/data/processed/.gitkeep
